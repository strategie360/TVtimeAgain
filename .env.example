# Les mêmes variables sont décrites dans docs/OPERATIONS.md (section Configuration).

# Postgres
# En local : ta base. En production (Neon) : l'adresse « pooled » (…-pooler…), avec ?sslmode=require
DATABASE_URL=postgres://localhost:5432/tvtime
# Production (Neon) uniquement : adresse directe, sans pooler, utilisée pour les migrations au déploiement
# DATABASE_URL_UNPOOLED=
# Connexions par instance : 10 en local, 3 sur Vercel (beaucoup d'instances courtes)
DATABASE_POOL_MAX=10
# Mettre "false" derrière un pooler en mode transaction (PgBouncer, pooler Neon)
DATABASE_PREPARE=true

# TMDB : https://www.themoviedb.org/settings/api  ("API Read Access Token", v4)
TMDB_TOKEN=
# Langue des métadonnées
TMDB_LANGUAGE=fr-FR

# Secret du job quotidien (Vercel Cron l'envoie tout seul dans l'en-tête Authorization)
CRON_SECRET=change-me

# Postgres
DATABASE_URL=postgres://localhost:5432/tvtime
DATABASE_POOL_MAX=10
# Mettre "false" si tu passes par PgBouncer en mode transaction
DATABASE_PREPARE=true

# TMDB : https://www.themoviedb.org/settings/api  ("API Read Access Token", v4)
TMDB_TOKEN=
# Langue des métadonnées
TMDB_LANGUAGE=fr-FR

# Secret pour déclencher le job de synchro via HTTP (cron externe)
CRON_SECRET=change-me

{
  "name": "tvtime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit migrate",
    "sync": "tsx --env-file=.env.local scripts/sync.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:preview": "NEXT_DIST_DIR=.next-preview next dev -p 3001",
    "recs:build": "tsx --env-file=.env.local scripts/recs-build.ts",
    "recs:eval": "tsx --env-file=.env.local scripts/recs-eval.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "fflate": "^0.8.2",
    "next": "15.5.4",
    "postgres": "^3.4.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "20.19.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.4",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}

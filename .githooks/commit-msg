#!/usr/bin/env bash
# Git commit-msg hook: Conventional Commits. Managed by the dev template.
set -u
msg_file="$1"
first_line="$(grep -v '^#' "$msg_file" | head -n1)"

# Let git's own generated messages through.
if [[ "$first_line" =~ ^(Merge |Revert \"|fixup! |squash! |amend! ) ]]; then
  exit 0
fi

re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ].*$'
if ! [[ "$first_line" =~ $re ]]; then
  {
    echo "commit-msg [commit-message]: message does not follow Conventional Commits:"
    echo "  \"$first_line\""
    echo "Expected: <type>(<optional scope>): <imperative summary>"
    echo "Types: feat fix docs style refactor perf test build ci chore revert"
    echo "Example: feat(auth): add password reset flow"
    echo "Rule explained in docs/WORKFLOW.md."
  } >&2
  exit 1
fi
if (( ${#first_line} > 72 )); then
  echo "commit-msg [commit-message]: first line is ${#first_line} characters; keep it at 72 or fewer." >&2
  exit 1
fi
exit 0
